/** Read-only customer-facing reporting facade. Explicit system mode is required by this org's field-visibility behavior. */
public without sharing class ChatAnalyticsDashboardController {
    @AuraEnabled(cacheable=true)
    public static DashboardData getDashboard(String analyzedFrom, String analyzedTo, String botResolutionStatus, String escalatedToHuman, String finalResolutionBy, String issueCategory, String escalationReason, String botImprovementOpportunity) {
        Date fromDate = parseDate(analyzedFrom); Date toDate = parseDate(analyzedTo);
        Map<String,Object> binds = new Map<String,Object>();
        List<String> whereParts = new List<String>();
        if (fromDate != null) { whereParts.add('Analyzed_At__c >= :fromDate'); binds.put('fromDate', fromDate); }
        if (toDate != null) { whereParts.add('Analyzed_At__c < :toExclusive'); binds.put('toExclusive', toDate.addDays(1)); }
        if (!String.isBlank(botResolutionStatus)) { whereParts.add('Bot_Resolution_Status__c = :botResolutionStatus'); binds.put('botResolutionStatus', botResolutionStatus); }
        if (!String.isBlank(finalResolutionBy)) { whereParts.add('Final_Resolution_By__c = :finalResolutionBy'); binds.put('finalResolutionBy', finalResolutionBy); }
        if (!String.isBlank(issueCategory)) { whereParts.add('Issue_Category__c = :issueCategory'); binds.put('issueCategory', issueCategory); }
        if (!String.isBlank(escalationReason)) { whereParts.add('Escalation_Reason__c = :escalationReason'); binds.put('escalationReason', escalationReason); }
        if (!String.isBlank(botImprovementOpportunity)) { whereParts.add('Bot_Improvement_Opportunity__c = :botImprovementOpportunity'); binds.put('botImprovementOpportunity', botImprovementOpportunity); }
        if (escalatedToHuman == 'true' || escalatedToHuman == 'false') { whereParts.add('Escalated_To_Human__c = :escalated'); binds.put('escalated', escalatedToHuman == 'true'); }
        String soql = 'SELECT Id, Chat_Conversation__c, Conversation_Identifier__c, Customer_Problem__c, Customer_Intent__c, Issue_Category__c, Bot_Resolution_Status__c, Escalated_To_Human__c, Escalation_Reason__c, Final_Resolution_By__c, Bot_Improvement_Opportunity__c, Bot_Turns_Before_Escalation__c, Bot_Failure_Reason__c, Analysis_Summary__c, Confidence__c, Analyzed_At__c FROM Chat_Analytics__c' + (whereParts.isEmpty() ? '' : ' WHERE ' + String.join(whereParts, ' AND ')) + ' ORDER BY Analyzed_At__c DESC NULLS LAST';
        DashboardData data = new DashboardData(); data.summary = new DashboardSummary(); data.rows = new List<ConversationAnalyticsRow>(); Map<String,Integer> issueCounts=new Map<String,Integer>(), escalationCounts=new Map<String,Integer>(), improvementCounts=new Map<String,Integer>();
        for (SObject record : Database.queryWithBinds(soql, binds, AccessLevel.SYSTEM_MODE)) {
            Chat_Analytics__c a = (Chat_Analytics__c)record; ConversationAnalyticsRow row = rowFor(a); data.rows.add(row); tally(data.summary, row); increment(issueCounts,row.issueCategory); increment(escalationCounts,row.escalationReason); increment(improvementCounts,row.botImprovementOpportunity);
        }
        finish(data.summary); data.issueCategories=dimensionCounts(issueCounts); data.escalationReasons=dimensionCounts(escalationCounts); data.improvementOpportunities=dimensionCounts(improvementCounts); return data;
    }
    @AuraEnabled(cacheable=true)
    public static ConversationDetail getConversationDetail(Id conversationRecordId) {
        if (conversationRecordId == null) return null;
        List<SObject> analyticsRecords = Database.queryWithBinds('SELECT Id, Chat_Conversation__c, Conversation_Identifier__c, Customer_Problem__c, Customer_Intent__c, Issue_Category__c, Bot_Resolution_Status__c, Escalated_To_Human__c, Escalation_Reason__c, Final_Resolution_By__c, Bot_Improvement_Opportunity__c, Bot_Turns_Before_Escalation__c, Bot_Failure_Reason__c, Analysis_Summary__c, Confidence__c, Evidence__c, Analyzed_At__c FROM Chat_Analytics__c WHERE Chat_Conversation__c = :conversationRecordId LIMIT 1', new Map<String,Object>{'conversationRecordId'=>conversationRecordId}, AccessLevel.SYSTEM_MODE);
        if (analyticsRecords.isEmpty()) return null;
        Chat_Analytics__c a=(Chat_Analytics__c)analyticsRecords[0];
        Chat_Conversation__c c=(Chat_Conversation__c)Database.queryWithBinds('SELECT Id, Conversation_Identifier__c, Start_Timestamp__c, End_Timestamp__c, Message_Count__c, Has_Human_Agent__c, Conversation_Status__c, Transcript__c FROM Chat_Conversation__c WHERE Id = :conversationRecordId',new Map<String,Object>{'conversationRecordId'=>conversationRecordId},AccessLevel.SYSTEM_MODE)[0];
        ConversationDetail d=new ConversationDetail(); copy(rowFor(a),d); d.startTimestamp=c.Start_Timestamp__c; d.endTimestamp=c.End_Timestamp__c; d.messageCount=c.Message_Count__c == null ? 0 : Integer.valueOf(c.Message_Count__c); d.hasHumanAgent=c.Has_Human_Agent__c; d.conversationStatus=c.Conversation_Status__c; d.transcript=c.Transcript__c; d.evidence=a.Evidence__c; d.messages=new List<RawMessageRow>();
        for(SObject record:Database.queryWithBinds('SELECT Id, Source_Row_Number__c, Participant_Display_Name__c, Participant_Role__c, Message_Category__c, Message_Text__c, Available_Options__c, Client_Timestamp_Raw__c FROM Chat_Message__c WHERE Chat_Conversation__c = :conversationRecordId ORDER BY Source_Row_Number__c ASC NULLS LAST, Client_Timestamp__c ASC NULLS LAST, CreatedDate ASC',new Map<String,Object>{'conversationRecordId'=>conversationRecordId},AccessLevel.SYSTEM_MODE)) { Chat_Message__c m=(Chat_Message__c)record; RawMessageRow r=new RawMessageRow(); r.rowNumber=m.Source_Row_Number__c == null ? null : Integer.valueOf(m.Source_Row_Number__c); r.participantDisplayName=m.Participant_Display_Name__c; r.participantRole=m.Participant_Role__c; r.messageCategory=m.Message_Category__c; r.messageText=m.Message_Text__c; r.availableOptions=m.Available_Options__c; r.clientTimestampRaw=m.Client_Timestamp_Raw__c; d.messages.add(r); }
        return d;
    }
    private static ConversationAnalyticsRow rowFor(Chat_Analytics__c a) { ConversationAnalyticsRow r=new ConversationAnalyticsRow(); r.conversationRecordId=a.Chat_Conversation__c; r.conversationIdentifier=a.Conversation_Identifier__c; r.customerProblem=a.Customer_Problem__c; r.customerIntent=a.Customer_Intent__c; r.issueCategory=(String)a.get('Issue_Category__c'); r.botResolutionStatus=a.Bot_Resolution_Status__c; r.escalatedToHuman=a.Escalated_To_Human__c; r.escalationReason=(String)a.get('Escalation_Reason__c'); r.finalResolutionBy=a.Final_Resolution_By__c; r.botImprovementOpportunity=(String)a.get('Bot_Improvement_Opportunity__c'); r.botTurnsBeforeEscalation=(Decimal)a.get('Bot_Turns_Before_Escalation__c'); r.botFailureReason=a.Bot_Failure_Reason__c; r.confidence=a.Confidence__c; r.analysisSummary=a.Analysis_Summary__c; r.analyzedAt=a.Analyzed_At__c; return r; }
    private static void copy(ConversationAnalyticsRow r, ConversationDetail d) { d.conversationRecordId=r.conversationRecordId; d.conversationIdentifier=r.conversationIdentifier; d.customerProblem=r.customerProblem; d.customerIntent=r.customerIntent; d.issueCategory=r.issueCategory; d.botResolutionStatus=r.botResolutionStatus; d.escalatedToHuman=r.escalatedToHuman; d.escalationReason=r.escalationReason; d.finalResolutionBy=r.finalResolutionBy; d.botImprovementOpportunity=r.botImprovementOpportunity; d.botTurnsBeforeEscalation=r.botTurnsBeforeEscalation; d.botFailureReason=r.botFailureReason; d.confidence=r.confidence; d.analysisSummary=r.analysisSummary; d.analyzedAt=r.analyzedAt; }
    private static void tally(DashboardSummary s, ConversationAnalyticsRow r) { s.totalConversations++; s.confidenceTotal += r.confidence == null ? 0 : r.confidence; if(r.botTurnsBeforeEscalation != null) {s.botTurnsTotal += r.botTurnsBeforeEscalation; s.botTurnsSampleSize++;} if(r.botResolutionStatus=='Resolved')s.botResolvedCount++; else if(r.botResolutionStatus=='Partially Resolved')s.partiallyResolvedCount++; else if(r.botResolutionStatus=='Not Resolved')s.botNotResolvedCount++; else s.indeterminateCount++; if(r.escalatedToHuman)s.escalatedCount++; if(r.finalResolutionBy=='Human Agent')s.humanResolvedCount++; if(r.finalResolutionBy=='Unresolved')s.unresolvedCount++; }
    private static void increment(Map<String,Integer> counts, String value) { String label=String.isBlank(value)?'Other':value; counts.put(label,(counts.containsKey(label)?counts.get(label):0)+1); }
    private static List<DimensionCount> dimensionCounts(Map<String,Integer> counts) { List<DimensionCount> output=new List<DimensionCount>(); for(String label:counts.keySet()){DimensionCount d=new DimensionCount();d.label=label;d.count=counts.get(label);output.add(d);} output.sort(); return output; }
    private static void finish(DashboardSummary s) { if(s.totalConversations==0)return; Decimal n=s.totalConversations; s.botResolvedPercent=100*s.botResolvedCount/n; s.partiallyResolvedPercent=100*s.partiallyResolvedCount/n; s.botNotResolvedPercent=100*s.botNotResolvedCount/n; s.escalatedPercent=100*s.escalatedCount/n; s.humanResolvedPercent=100*s.humanResolvedCount/n; s.unresolvedPercent=100*s.unresolvedCount/n; s.averageConfidence=s.confidenceTotal/n; s.averageBotTurnsBeforeEscalation=s.botTurnsSampleSize==0?null:s.botTurnsTotal/s.botTurnsSampleSize; }
    private static Date parseDate(String value) { if(String.isBlank(value))return null; try{return Date.valueOf(value);}catch(Exception ignored){return null;} }
    public class DashboardData { @AuraEnabled public DashboardSummary summary; @AuraEnabled public List<ConversationAnalyticsRow> rows; @AuraEnabled public List<DimensionCount> issueCategories; @AuraEnabled public List<DimensionCount> escalationReasons; @AuraEnabled public List<DimensionCount> improvementOpportunities; }
    public class DashboardSummary { @AuraEnabled public Integer totalConversations=0; @AuraEnabled public Integer botResolvedCount=0; @AuraEnabled public Decimal botResolvedPercent=0; @AuraEnabled public Integer partiallyResolvedCount=0; @AuraEnabled public Decimal partiallyResolvedPercent=0; @AuraEnabled public Integer botNotResolvedCount=0; @AuraEnabled public Decimal botNotResolvedPercent=0; @AuraEnabled public Integer indeterminateCount=0; @AuraEnabled public Integer escalatedCount=0; @AuraEnabled public Decimal escalatedPercent=0; @AuraEnabled public Integer humanResolvedCount=0; @AuraEnabled public Decimal humanResolvedPercent=0; @AuraEnabled public Integer unresolvedCount=0; @AuraEnabled public Decimal unresolvedPercent=0; @AuraEnabled public Decimal confidenceTotal=0; @AuraEnabled public Decimal averageConfidence=0; @AuraEnabled public Decimal botTurnsTotal=0; @AuraEnabled public Integer botTurnsSampleSize=0; @AuraEnabled public Decimal averageBotTurnsBeforeEscalation; }
    public class DimensionCount implements Comparable { @AuraEnabled public String label; @AuraEnabled public Integer count; public Integer compareTo(Object other){return ((DimensionCount)other).count-this.count;} }
    public virtual class ConversationAnalyticsRow { @AuraEnabled public Id conversationRecordId; @AuraEnabled public String conversationIdentifier; @AuraEnabled public String customerProblem; @AuraEnabled public String customerIntent; @AuraEnabled public String issueCategory; @AuraEnabled public String botResolutionStatus; @AuraEnabled public Boolean escalatedToHuman; @AuraEnabled public String escalationReason; @AuraEnabled public String finalResolutionBy; @AuraEnabled public String botImprovementOpportunity; @AuraEnabled public Decimal botTurnsBeforeEscalation; @AuraEnabled public String botFailureReason; @AuraEnabled public Decimal confidence; @AuraEnabled public String analysisSummary; @AuraEnabled public Datetime analyzedAt; }
    public class ConversationDetail extends ConversationAnalyticsRow { @AuraEnabled public Datetime startTimestamp; @AuraEnabled public Datetime endTimestamp; @AuraEnabled public Integer messageCount; @AuraEnabled public Boolean hasHumanAgent; @AuraEnabled public String conversationStatus; @AuraEnabled public String transcript; @AuraEnabled public String evidence; @AuraEnabled public List<RawMessageRow> messages; }
    public class RawMessageRow { @AuraEnabled public Integer rowNumber; @AuraEnabled public String participantDisplayName; @AuraEnabled public String participantRole; @AuraEnabled public String messageCategory; @AuraEnabled public String messageText; @AuraEnabled public String availableOptions; @AuraEnabled public String clientTimestampRaw; }
}